<?xml version="1.0" encoding="UTF-8"?>
<xs:schema xmlns:xs="http://www.w3.org/2001/XMLSchema"
           targetNamespace="urn:xmpp:qtnote:note:1"
           xmlns="urn:xmpp:qtnote:note:1"
           elementFormDefault="qualified">
  <xs:complexType name="indexType">
    <xs:sequence>
      <xs:element name="title" type="xs:string"/>
      <xs:element name="tag" type="xs:string" minOccurs="0" maxOccurs="unbounded"/>
      <xs:any minOccurs="0" maxOccurs="unbounded" namespace="##other" processContents="lax"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
    <xs:attribute name="revision" type="xs:string" use="required"/>
    <xs:attribute name="parent-revision" type="xs:string"/>
    <xs:attribute name="origin-id" type="xs:string"/>
    <xs:attribute name="modified" type="xs:dateTime" use="required"/>
    <xs:attribute name="format" type="xs:string" use="required"/>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>
  <xs:complexType name="noteType">
    <xs:sequence>
      <xs:element name="body" type="xs:string"/>
      <xs:any minOccurs="0" maxOccurs="unbounded" namespace="##other" processContents="lax"/>
    </xs:sequence>
    <xs:attribute name="id" type="xs:string" use="required"/>
    <xs:attribute name="revision" type="xs:string" use="required"/>
    <xs:anyAttribute processContents="lax"/>
  </xs:complexType>
  <xs:element name="index" type="indexType"/>
  <xs:element name="note" type="noteType"/>
</xs:schema>
