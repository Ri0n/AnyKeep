<?xml version="1.0"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs" xmlns:bal="http://wixtoolset.org/schemas/v4/wxs/bal" xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
    <Bundle Name="AnyKeep" Version="@VERSION_FOR_WIX@" Manufacturer="R-Soft" UpgradeCode="@UPGRADE_CODE@">
        <BootstrapperApplication>
            <bal:WixStandardBootstrapperApplication
                LicenseFile="GPLv3.rtf"
                LogoFile="@LOGO_FILE@"
                Theme="rtfLargeLicense" />
            <Payload SourceFile="@LICENSE_RTF@" />
            <Payload SourceFile="@LOGO_FILE@" />
        </BootstrapperApplication>

        <util:RegistrySearch
            Id="LegacyAnyKeep32Search"
            Variable="LegacyAnyKeep32"
            Root="HKLM"
            Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\AnyKeep"
            Value="UninstallString"
            Result="exists"
            Bitness="always32"
        />
        <util:RegistrySearch
            Id="LegacyAnyKeep64Search"
            Variable="LegacyAnyKeep64"
            Root="HKLM"
            Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\AnyKeep"
            Value="UninstallString"
            Result="exists"
            Bitness="always64"
        />
        <util:RegistrySearch
            Id="LegacyQtNote32Search"
            Variable="LegacyQtNote32"
            Root="HKLM"
            Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\QtNote"
            Value="UninstallString"
            Result="exists"
            Bitness="always32"
        />
        <util:RegistrySearch
            Id="LegacyQtNote64Search"
            Variable="LegacyQtNote64"
            Root="HKLM"
            Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Uninstall\QtNote"
            Value="UninstallString"
            Result="exists"
            Bitness="always64"
        />

        <bal:Condition
            Condition="WixBundleInstalled OR (NOT LegacyAnyKeep32 AND NOT LegacyAnyKeep64 AND NOT LegacyQtNote32 AND NOT LegacyQtNote64)"
            Message="A previous system-wide AnyKeep or QtNote installation was found. Uninstall it from Windows Settings, then run this installer again. Your notes and settings will not be removed."
        />

        <util:RegistrySearch
            Id="VCRedistInstalledSearch"
            Variable="VCRedistInstalled"
            Root="HKLM"
            Key="SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\x64"
            Value="Installed"
            Result="value"
        />
        <util:RegistrySearch
            Id="VCRedistVersionSearch"
            Variable="VCRedistVersion"
            Root="HKLM"
            Key="SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\x64"
            Value="Version"
            Result="value"
        />

        <Chain>
            <ExePackage
                DetectCondition="VCRedistInstalled AND VCRedistVersion >= v@ANYKEEP_REQUIRED_VC_RUNTIME_VERSION@"
                InstallCondition="NOT VCRedistInstalled OR VCRedistVersion &lt; v@ANYKEEP_REQUIRED_VC_RUNTIME_VERSION@"
                InstallArguments="/quiet /norestart"
                Permanent="yes"
                Vital="yes">
                @ANYKEEP_VC_REDIST_PAYLOAD_XML@
                <ExitCode Behavior="success" Value="3010"/>  <!-- ignore reboot -->
                <ExitCode Behavior="success" Value="0"/>     <!-- success -->
                <ExitCode Behavior="success" Value="1638"/>  <!-- a newer version is already installed -->
            </ExePackage>

            <MsiPackage SourceFile="@ANYKEEP_MSI@" />
        </Chain>
    </Bundle>
</Wix>
