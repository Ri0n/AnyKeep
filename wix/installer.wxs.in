<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
    <Package
        Name="AnyKeep"
        Manufacturer="R-Soft"
        Version="@VERSION_FOR_WIX@"
        UpgradeCode="@UPGRADE_CODE@"
        InstallerVersion="500"
        Compressed="yes"
        Scope="perUser">

        <Media Id="1" Cabinet="product.cab" EmbedCab="yes" />

        <Property Id="ANYKEEP_INSTALL_ROOT">
            <RegistrySearch Id="AnyKeepInstallRootSearch"
                            Root="HKCU"
                            Key="Software\R-Soft\AnyKeep"
                            Name="InstallRoot"
                            Type="directory" />
        </Property>

        <StandardDirectory Id="LocalAppDataFolder">
            <Directory Id="ProgramsDirectory" Name="Programs">
                <Directory Id="APPLICATIONROOTDIRECTORY" Name="AnyKeep">
                    <Component Id="AnyKeepLauncherComponent" Guid="*" Bitness="always64">
                        <File Id="AnyKeepLauncherFile"
                              Name="AnyKeepLauncher.exe"
                              Source="@LAUNCHER_FILE@" />
                        <RegistryValue Root="HKCU"
                                       Key="Software\R-Soft\AnyKeep"
                                       Name="InstallRoot"
                                       Type="string"
                                       Value="[APPLICATIONROOTDIRECTORY]"
                                       KeyPath="yes" />
                        <util:RemoveFolderEx Id="RemoveAnyKeepInstallRoot"
                                             Property="ANYKEEP_INSTALL_ROOT"
                                             On="uninstall" />
                    </Component>
                    <Directory Id="VersionsDirectory" Name="versions">
                        <Directory Id="CurrentVersionDirectory" Name="@ANYKEEP_VERSION@">
                            @COMPONENTS@
                        </Directory>
                    </Directory>
                    <Directory Id="StagingDirectory" Name="staging" />
                    <Directory Id="UpdateLogsDirectory" Name="update-logs" />
                </Directory>
            </Directory>
        </StandardDirectory>

        <StandardDirectory Id="ProgramMenuFolder">
            <Directory Id="ProgramMenuDir" Name="AnyKeep">
                <Component Id="StartMenuShortcuts" Guid="*" Bitness="always64">
                    <RemoveFolder Id="ProgramMenuDir" On="uninstall" />
                    <RegistryValue Root="HKCU"
                                   Key="Software\R-Soft\AnyKeep"
                                   Name="StartMenuShortcut"
                                   Type="integer"
                                   Value="1"
                                   KeyPath="yes" />
                    <Shortcut Id="ExeShortcut"
                              Name="AnyKeep"
                              Description="Launch AnyKeep"
                              Target="[APPLICATIONROOTDIRECTORY]AnyKeepLauncher.exe"
                              WorkingDirectory="APPLICATIONROOTDIRECTORY">
                        <ShortcutProperty Key="System.AppUserModel.ID"
                                          Value="com.github.ri0n.AnyKeep" />
                    </Shortcut>
                </Component>
            </Directory>
        </StandardDirectory>

        <Feature Id="DefaultFeature" Title="Main Feature" Level="1">
            <ComponentRef Id="AnyKeepLauncherComponent" />
            @COMPONENT_REFS@
            <ComponentRef Id="StartMenuShortcuts" />
        </Feature>

        <Icon Id="icon.ico" SourceFile="@LOGO_FILE@" />
        <Property Id="ARPPRODUCTICON" Value="icon.ico" />
        <MajorUpgrade
            DowngradeErrorMessage="A later version of [ProductName] is already installed. Setup will now exit."
            Schedule="afterInstallInitialize"
            AllowSameVersionUpgrades="yes" />
    </Package>
</Wix>
