<?xml version="1.0" encoding="UTF-8"?>
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">
    <Package
        Name="AnyKeep"
        Manufacturer="R-Soft"
        Version="@VERSION_FOR_WIX@"
        UpgradeCode="@UPGRADE_CODE@"
        InstallerVersion="500"
        Compressed="yes"
        Scope="perUser">

        <Media Id="1" Cabinet="product.cab" EmbedCab="yes" />

        <Property Id="LEGACY_ANYKEEP_32">
            <RegistrySearch Id="LegacyAnyKeep32Search"
                            Root="HKLM"
                            Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\AnyKeep"
                            Name="UninstallString"
                            Type="raw"
                            Bitness="always32" />
        </Property>
        <Property Id="LEGACY_ANYKEEP_64">
            <RegistrySearch Id="LegacyAnyKeep64Search"
                            Root="HKLM"
                            Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\AnyKeep"
                            Name="UninstallString"
                            Type="raw"
                            Bitness="always64" />
        </Property>
        <Property Id="LEGACY_QTNOTE_32">
            <RegistrySearch Id="LegacyQtNote32Search"
                            Root="HKLM"
                            Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\QtNote"
                            Name="UninstallString"
                            Type="raw"
                            Bitness="always32" />
        </Property>
        <Property Id="LEGACY_QTNOTE_64">
            <RegistrySearch Id="LegacyQtNote64Search"
                            Root="HKLM"
                            Key="Software\Microsoft\Windows\CurrentVersion\Uninstall\QtNote"
                            Name="UninstallString"
                            Type="raw"
                            Bitness="always64" />
        </Property>

        <Launch Condition="ACTION = &quot;ADMIN&quot; OR Installed OR (NOT LEGACY_ANYKEEP_32 AND NOT LEGACY_ANYKEEP_64 AND NOT LEGACY_QTNOTE_32 AND NOT LEGACY_QTNOTE_64)"
                Message="A previous system-wide AnyKeep or QtNote installation was found. Uninstall it from Windows Settings, then run this installer again. Your notes and settings will not be removed." />

        <!--
            Burn normally installs the Visual C++ runtime before invoking this MSI, but the MSI is also distributed as
            the canonical self-update/direct-install package. Keep it safe to launch on its own: administrative images,
            repairs and removals do not need the runtime, while a fresh direct installation must have a sufficiently new
            x64 v14 redistributable. RegistrySearch returns REG_DWORD values with a '#' prefix in MSI properties.
        -->
        <Property Id="ANYKEEP_VC_RUNTIME_X64_INSTALLED">
            <RegistrySearch Id="AnyKeepVCRuntimeX64InstalledSearch"
                            Root="HKLM"
                            Key="Software\Microsoft\VisualStudio\14.0\VC\Runtimes\x64"
                            Name="Installed"
                            Type="raw"
                            Bitness="always64" />
        </Property>
        <Property Id="ANYKEEP_VC_RUNTIME_X64_VERSION_OK">
            <DirectorySearch Id="AnyKeepVCRuntimeX64DirectorySearch"
                             Path="[System64Folder]"
                             Depth="0">
                <FileSearch Id="AnyKeepVCRuntimeX64FileSearch"
                            Name="vcruntime140.dll"
                            MinVersion="@ANYKEEP_VC_RUNTIME_FILE_SEARCH_MIN_VERSION@" />
            </DirectorySearch>
        </Property>
        <Launch Condition="ACTION = &quot;ADMIN&quot; OR Installed OR (ANYKEEP_VC_RUNTIME_X64_INSTALLED = &quot;#1&quot; AND ANYKEEP_VC_RUNTIME_X64_VERSION_OK)"
                Message="AnyKeep requires Microsoft Visual C++ Redistributable (x64) @ANYKEEP_REQUIRED_VC_RUNTIME_VERSION@ or later. Install the current supported Visual C++ v14 Redistributable and run this MSI again." />

        <Property Id="ANYKEEP_INSTALL_ROOT">
            <RegistrySearch Id="AnyKeepInstallRootSearch"
                            Root="HKCU"
                            Key="Software\R-Soft\AnyKeep"
                            Name="InstallRoot"
                            Type="directory" />
        </Property>

        <StandardDirectory Id="LocalAppDataFolder">
            <Directory Id="ProgramsDirectory" Name="Programs">
                <Directory Id="APPLICATIONROOTDIRECTORY" Name="AnyKeep">
                    <Component Id="AnyKeepLauncherComponent" Guid="*" Bitness="always64">
                        <File Id="AnyKeepLauncherFile"
                              Name="AnyKeepLauncher.exe"
                              Source="@LAUNCHER_FILE@" />
                    </Component>
                    <Component Id="AnyKeepInstallRootComponent" Guid="*" Bitness="always64">
                        <RegistryValue Root="HKCU"
                                       Key="Software\R-Soft\AnyKeep"
                                       Name="InstallRoot"
                                       Type="string"
                                       Value="[APPLICATIONROOTDIRECTORY]"
                                       KeyPath="yes" />
                        <util:RemoveFolderEx Id="RemoveAnyKeepInstallRoot"
                                             Property="ANYKEEP_INSTALL_ROOT"
                                             On="uninstall" />
                    </Component>
                    <Directory Id="VersionsDirectory" Name="versions">
                        <Directory Id="CurrentVersionDirectory" Name="@ANYKEEP_VERSION@">
                            @COMPONENTS@
                        </Directory>
                    </Directory>
                    <Directory Id="StagingDirectory" Name="staging" />
                    <Directory Id="UpdateLogsDirectory" Name="update-logs" />
                </Directory>
            </Directory>
        </StandardDirectory>

        <StandardDirectory Id="ProgramMenuFolder">
            <Directory Id="ProgramMenuDir" Name="AnyKeep">
                <Component Id="StartMenuShortcuts" Guid="*" Bitness="always64">
                    <RemoveFolder Id="ProgramMenuDir" On="uninstall" />
                    <RegistryValue Root="HKCU"
                                   Key="Software\R-Soft\AnyKeep"
                                   Name="StartMenuShortcut"
                                   Type="integer"
                                   Value="1"
                                   KeyPath="yes" />
                    <Shortcut Id="ExeShortcut"
                              Name="AnyKeep"
                              Description="Launch AnyKeep"
                              Target="[APPLICATIONROOTDIRECTORY]AnyKeepLauncher.exe"
                              WorkingDirectory="APPLICATIONROOTDIRECTORY">
                        <ShortcutProperty Key="System.AppUserModel.ID"
                                          Value="com.github.ri0n.AnyKeep" />
                    </Shortcut>
                </Component>
            </Directory>
        </StandardDirectory>

        <Feature Id="DefaultFeature" Title="Main Feature" Level="1">
            <ComponentRef Id="AnyKeepLauncherComponent" />
            <ComponentRef Id="AnyKeepInstallRootComponent" />
            @COMPONENT_REFS@
            <ComponentRef Id="StartMenuShortcuts" />
        </Feature>

        <Icon Id="icon.ico" SourceFile="@LOGO_FILE@" />
        <Property Id="ARPPRODUCTICON" Value="icon.ico" />
        <MajorUpgrade
            DowngradeErrorMessage="A later version of [ProductName] is already installed. Setup will now exit."
            Schedule="afterInstallInitialize"
            AllowSameVersionUpgrades="yes" />
    </Package>
</Wix>
