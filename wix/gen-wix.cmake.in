cmake_minimum_required(VERSION 3.25.0)

function(wix_id_for_path path prefix output)
    file(RELATIVE_PATH relative_path "${CMAKE_INSTALL_PREFIX}" "${path}")
    string(MAKE_C_IDENTIFIER "${prefix}_${relative_path}" wix_id)
    string(TOUPPER "${wix_id}" wix_id)
    string(LENGTH "${wix_id}" wix_id_length)
    if(wix_id_length GREATER 72)
        # WiX standard identifiers are limited to 72 characters. Keep a
        # readable prefix and suffix it with a deterministic path hash, so
        # long Qt Quick asset names remain unique and stable across builds.
        string(SHA256 wix_id_hash "${relative_path}")
        string(SUBSTRING "${wix_id_hash}" 0 16 wix_id_hash)
        string(SUBSTRING "${wix_id}" 0 55 wix_id_prefix)
        set(wix_id "${wix_id_prefix}_${wix_id_hash}")
    endif()
    set(${output} "${wix_id}" PARENT_SCOPE)
endfunction()

function(generate_wxs_dir dir_to_glob indent)
    file(GLOB all_entries LIST_DIRECTORIES true "${dir_to_glob}/*")
    set(files "")
    set(dirs "")
    foreach(entry IN LISTS all_entries)
        if(IS_DIRECTORY "${entry}")
            list(APPEND dirs "${entry}")
        else()
            get_filename_component(entry_name "${entry}" NAME)
            if(entry_name STREQUAL "AnyKeepLauncher.exe" OR entry_name STREQUAL "current.version")
                continue()
            endif()
            if(entry_name STREQUAL "vc_redist.x64.exe")
                continue()
            endif()
            list(APPEND files "${entry}")
        endif()
    endforeach()

    set(components "")
    set(component_refs "")
    foreach(file IN LISTS files)
        get_filename_component(file_name "${file}" NAME)
        wix_id_for_path("${file}" "FILE" file_id)
        wix_id_for_path("${file}" "COMPONENT" component_id)
        string(APPEND components "
            ${indent}<Component Id=\"${component_id}\" Guid=\"*\" Bitness=\"always64\">
            ${indent}    <File Id=\"${file_id}\" Name=\"${file_name}\" Source=\"${file}\" KeyPath=\"yes\" />
            ${indent}</Component>")
        string(APPEND component_refs "
          <ComponentRef Id=\"${component_id}\" />")
    endforeach()

    foreach(dir IN LISTS dirs)
        generate_wxs_dir("${dir}" "${indent}    ")
        set(child_components "${components_res}")
        set(child_refs "${component_refs_res}")
        get_filename_component(dir_name "${dir}" NAME)
        wix_id_for_path("${dir}" "DIRECTORY" dir_id)
        string(APPEND components "
            ${indent}<Directory Id=\"${dir_id}\" Name=\"${dir_name}\">
            ${indent}    ${child_components}
            ${indent}</Directory>")
        string(APPEND component_refs "${child_refs}")
    endforeach()

    set(components_res "${components}" PARENT_SCOPE)
    set(component_refs_res "${component_refs}" PARENT_SCOPE)
endfunction()

function(generate_wxs output_file)
    generate_wxs_dir("${CMAKE_INSTALL_PREFIX}" "")
    set(COMPONENTS "${components_res}")
    set(COMPONENT_REFS "${component_refs_res}")
    set(LAUNCHER_FILE "${CMAKE_INSTALL_PREFIX}/AnyKeepLauncher.exe")
    if(NOT EXISTS "${LAUNCHER_FILE}")
        message(FATAL_ERROR "AnyKeepLauncher.exe was not installed into ${CMAKE_INSTALL_PREFIX}")
    endif()
    configure_file("${WIX_TEMPLATE}" "${output_file}" @ONLY)
endfunction()

generate_wxs("${WIX_OUTPUT}")
