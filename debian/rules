#!/usr/bin/make -f

#export DH_VERBOSE = 1

include debian/build-profile.mk

CCACHE := $(shell command -v ccache 2>/dev/null)
ifneq ($(CCACHE),)
CCACHE_CMAKE_ARGS := \
	-DCMAKE_C_COMPILER_LAUNCHER=$(CCACHE) \
	-DCMAKE_CXX_COMPILER_LAUNCHER=$(CCACHE)
endif

%:
	dh $@ --buildsystem=cmake

override_dh_auto_configure:
	dh_auto_configure -- \
		-DQT_VERSION_MAJOR=$(QT_VERSION_MAJOR) \
		$(ANYKEEP_CMAKE_ARGS) \
		$(ANYKEEP_CMAKE_EXTRA_ARGS) \
		$(CCACHE_CMAKE_ARGS)

# QCA is bundled privately with libanykeep3 for the Iris build profile. It has
# no Debian shlibs/symbols file, so resolve it in the staged package and omit
# only its unavailable dependency metadata.
override_dh_shlibdeps:
	dh_shlibdeps -l$(CURDIR)/debian/libanykeep3/usr/lib/$(DEB_HOST_MULTIARCH)/anykeep -- --ignore-missing-info
