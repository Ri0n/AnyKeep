#!/usr/bin/make -f

#export DH_VERBOSE = 1

include debian/build-profile.mk

CCACHE := $(shell command -v ccache 2>/dev/null)
ifneq ($(CCACHE),)
CCACHE_CMAKE_ARGS := \
	-DCMAKE_C_COMPILER_LAUNCHER=$(CCACHE) \
	-DCMAKE_CXX_COMPILER_LAUNCHER=$(CCACHE)
endif

%:
	dh $@ --buildsystem=cmake

override_dh_auto_configure:
	dh_auto_configure -- \
		-DQT_VERSION_MAJOR=$(QT_VERSION_MAJOR) \
		$(ANYKEEP_CMAKE_ARGS) \
		$(ANYKEEP_CMAKE_EXTRA_ARGS) \
		$(CCACHE_CMAKE_ARGS)

# Keep the existing staged-library lookup. Dependency versions for the
# application itself are generated from dependencies.lock.json at gencontrol.
override_dh_shlibdeps:
	dh_shlibdeps -l$(CURDIR)/debian/libanykeep3/usr/lib/$(DEB_HOST_MULTIARCH)/anykeep -- --ignore-missing-info

# Runtime requirements are sourced from dependency-specific minimum_version
# fields in the lock, not from the nightly-selected build tags.
override_dh_gencontrol:
	runtime_depends=$(python3 packaging/debian/runtime-depends.py --depends) || exit $?; \
	dh_gencontrol -- "-Vruntime:Depends=$runtime_depends"
