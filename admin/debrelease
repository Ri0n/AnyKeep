#!/bin/bash

gittag2version() {
  # remove hash and sum to last numbers. e.g. 3.99.0-35-gdfsdfggw => 3.99.35
  # (so please avoid using anything but 0 in the patch part of version)
  local git_version=$(echo "$1" | sed 's/-g[a-z0-9]\{7,\}//')
  gv_lp=${git_version##*.}
  case "$gv_lp" in
    *-*) build_v=$(expr ${gv_lp%-*} + ${gv_lp#*-}) ;;
    *) build_v="$gv_lp" ;;
  esac
  echo "${git_version%.*}.$build_v"
}

# Only release-version tags participate in Debian version generation. Service
# tags such as "nightly" and "deps-*" must never become package versions.
git_version=$(git describe --tags --match '[0-9]*' 2>/dev/null)
if [ -n "$git_version" ]; then
  git_version=$(gittag2version "$git_version")
  if [ "$(dpkg-parsechangelog --show-field Version)" = "$git_version" ]; then
    exit 0
  fi
else
  echo "Failed to fetch version from git tag"
  exit 1
fi

dch -M -v ${git_version} "New release"
