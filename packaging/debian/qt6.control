Source: anykeep
Section: text
Priority: optional
Maintainer: Sergei Ilinykh <rion4ik@gmail.com>
Build-Depends: cmake (>= 3.25.0), dh-cmake, dh-cmake-compat (= 1), dh-sequence-cmake, debhelper (>= 11), qt6-base-dev, qt6-base-dev-tools, qt6-tools-dev, qt6-tools-dev-tools, qt6-declarative-dev, qt6-multimedia-dev, qt6-svg-dev, libqca3-qt6-dev, libiris-qt6-dev, qtkeychain-qt6-dev, extra-cmake-modules, libplasma-dev, libkf6config-dev, libkf6coreaddons-dev, libkf6globalaccel-dev, libkf6windowsystem-dev, libkf6notifications-dev, libhunspell-dev, libx11-dev, pkgconf
Standards-Version: 4.5.1
Homepage: https://anykeep.net
Vcs-Git: https://github.com/Ri0n/AnyKeep.git
Vcs-Browser: https://github.com/Ri0n/anykeep

Package: libanykeep3
Architecture: any
Depends: qml6-module-qtqml-workerscript,
 qml6-module-qtquick,
 qml6-module-qtquick-controls,
 qml6-module-qtquick-layouts,
 qml6-module-qtquick-templates,
 qml6-module-qtquick-window,
 qt6-svg-plugins,
 ${shlibs:Depends},
 ${misc:Depends}
Description: AnyKeep library to work with various notes storages
 Also works with AnyKeep plugins and able to provide some GUI

Package: libanykeep-dev
Architecture: any
Depends: libanykeep3 (= ${binary:Version}), ${misc:Depends}
Description: AnyKeep development files
 Development files to write plugins or to work directly with the AnyKeep library

Package: anykeep
Architecture: any
Depends: libanykeep3 (= ${binary:Version}), ${shlibs:Depends}, ${misc:Depends}
Recommends: wl-clipboard
Description: Note-taking application written with Qt in mind.
 It's mostly Tomboy clone but with less features. So it's app
 which lives in your system tray and allows you to make notes quickly
